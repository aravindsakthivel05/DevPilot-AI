# Export these variables in the backend shell. No .env loader is used.
# Example: export DEVPILOT_LLM_BASE_URL=http://localhost:11434/v1
DEVPILOT_LLM_BASE_URL=
DEVPILOT_LLM_MODEL=
DEVPILOT_PROPOSAL_MODEL=
DEVPILOT_API_KEY=
DEVPILOT_EMBEDDING_MODEL=
DEVPILOT_EMBEDDING_BASE_URL=
# Optional pinned model revision; changing it invalidates stored vectors.
DEVPILOT_EMBEDDING_REVISION=
DEVPILOT_PROVIDER_TIMEOUT_SECONDS=90
# Local Ollama is detected automatically when the base URL uses localhost:11434.
# Set to 0 to keep the OpenAI-compatible endpoint, or 1 to force Ollama's native chat API.
DEVPILOT_OLLAMA_NATIVE_API=auto
DEVPILOT_OLLAMA_KEEP_ALIVE=10m
# Explicit local context; increasing it uses more memory. Planning estimates are not exact tokens.
DEVPILOT_OLLAMA_NUM_CTX=8192
DEVPILOT_SOURCE_TOKEN_BUDGET=4096
# Extra model review of claims. Adds latency; it is fallible and cannot prove correctness.
DEVPILOT_VERIFY_CLAIMS=1
# Enable the opt-in LangGraph investigation and guided-repair workflows.
DEVPILOT_LANGGRAPH_ENABLED=0
# Optional legacy execution routes; disabled in the research prototype's core.
DEVPILOT_LEGACY_EXECUTION=0
# Custom RAG weights. RRF rank scores and structural boosts have different scales.
DEVPILOT_LEXICAL_WEIGHT=1
DEVPILOT_SEMANTIC_WEIGHT=1
DEVPILOT_GRAPH_WEIGHT=1
DEVPILOT_STRUCTURAL_WEIGHT=0.02
DEVPILOT_EXACT_BOOST=50
DEVPILOT_RERANK=1
