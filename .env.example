# Export these variables in the backend shell. No .env loader is used.
# Example: export DEVPILOT_LLM_BASE_URL=http://localhost:11434/v1
DEVPILOT_LLM_BASE_URL=
DEVPILOT_LLM_MODEL=
DEVPILOT_PROPOSAL_MODEL=
DEVPILOT_API_KEY=
DEVPILOT_EMBEDDING_MODEL=
DEVPILOT_PROVIDER_TIMEOUT_SECONDS=90
# Local Ollama is detected automatically when the base URL uses localhost:11434.
# Set to 0 to keep the OpenAI-compatible endpoint, or 1 to force Ollama's native chat API.
DEVPILOT_OLLAMA_NATIVE_API=auto
DEVPILOT_OLLAMA_KEEP_ALIVE=10m
# Enable the opt-in LangGraph investigation and guided-repair workflows.
DEVPILOT_LANGGRAPH_ENABLED=0
